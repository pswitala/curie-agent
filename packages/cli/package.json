{
  "name": "@curie-agent/cli",
  "version": "0.1.0",
  "publish": true,
  "type": "module",
  "files": [
    "dist",
    "templates"
  ],
  "main": "./dist/src/cli.js",
  "types": "./dist/src/cli.d.ts",
  "bin": {
    "curie-agent": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/cli.js",
      "types": "./dist/src/cli.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "npx rimraf dist"
  },
  "dependencies": {
    "@curie-agent/core": "workspace:^0.1.0",
    "@curie-agent/mcp": "workspace:^0.1.0",
    "@curie-agent/protocol": "workspace:^0.1.0",
    "@curie-agent/providers": "workspace:^0.1.0",
    "@curie-agent/render": "workspace:^0.1.0",
    "@curie-agent/tools": "workspace:^0.1.0",
    "@curie-agent/tui": "workspace:^0.1.0",
    "@types/react": "^19.0.0",
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
