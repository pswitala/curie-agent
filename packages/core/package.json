{
  "name": "@curie-agent/core",
  "version": "0.4.2",
  "publish": true,
  "type": "module",
  "files": [
    "dist",
    "templates"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./safety/path-guard.js": {
      "import": "./dist/src/safety/path-guard.js",
      "types": "./dist/src/safety/path-guard.d.ts"
    },
    "./safety/command-guard.js": {
      "import": "./dist/src/safety/command-guard.js",
      "types": "./dist/src/safety/command-guard.d.ts"
    },
    "./safety/tool-digest.js": {
      "import": "./dist/src/safety/tool-digest.js",
      "types": "./dist/src/safety/tool-digest.d.ts"
    },
    "./safety/snapshot.js": {
      "import": "./dist/src/safety/snapshot.js",
      "types": "./dist/src/safety/snapshot.d.ts"
    },
    "./shell-detect.js": {
      "import": "./dist/src/shell-detect.js",
      "types": "./dist/src/shell-detect.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "npx rimraf dist"
  },
  "dependencies": {
    "grammy": "^1.42.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
